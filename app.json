{
  "expo": {
    "name": "Organizador Diario",
    "slug": "organizador-diario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "organizador-diario",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ghuinz17.organizadordiario"
    },
    "android": {
      "package": "com.ghuinz17.organizadordiario",
      "adaptiveIcon": {
        "backgroundColor": "#14181F",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B1220",
            "image": "./assets/logo.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99bed2ca-dbe7-4bfa-a345-fcb4c0a0d04d"
      }
    },
    "owner": "amolper",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99bed2ca-dbe7-4bfa-a345-fcb4c0a0d04d"
    }
  }
}
